# GRUPO E — copie este modelo para .env.local com npm run env:setup.
# Preencha os valores vazios apenas no .env.local ou nas configurações da Vercel.
# Nunca envie .env.local, chaves ou senhas ao GitHub/chat.

# OBRIGATÓRIAS PARA O SITE E O PAINEL ATUAIS
# Supabase > Project Settings > API Keys.
SUPABASE_URL=https://rjcovpfddmwwetqlrnas.supabase.co
SUPABASE_SECRET_KEY=
# Use a Secret key (sb_secret_...). Não é a senha do banco nem a Publishable key.
# Alternativa legada: SUPABASE_SERVICE_ROLE_KEY (use apenas uma das duas).

# Login do painel atual. Gere com npm run admin:setup.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# RESERVADAS PARA A FUTURA AUTENTICAÇÃO INDIVIDUAL (SUPABASE AUTH)
# Estes campos ainda não são utilizados pelo login atual e podem ficar sem chave.
NEXT_PUBLIC_SUPABASE_URL=https://rjcovpfddmwwetqlrnas.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Apenas a Publishable key (sb_publishable_...) pode ter NEXT_PUBLIC_.
# Preencher estes campos não cria usuários nem ativa os perfis de acesso.

# CONTATOS — confirme os números antes da publicação (país + DDD + número).
NEXT_PUBLIC_WHATSAPP_LOJAS=5579998613913
NEXT_PUBLIC_WHATSAPP_EMBALACENTER=5579996826742
